# Ignore everything in the parent directory
/*

# Keep these root-level files
!/.gitignore
!/*.sh
!/*.md
!/*.Rmd

# Make sure no other root folders sneak back in
/*/

# Keep the archive folder itself...
!/archive/

# ...but ignore everything inside it
/archive/*

# Except first-level .sh, .md, and .Rmd files
!/archive/*.sh
!/archive/*.md
!/archive/*.Rmd

# Keep subfolders of archive ignored, even if their names end in .sh/.md/.Rmd
/archive/*/